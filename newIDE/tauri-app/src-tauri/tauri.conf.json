{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GDevelop 5",
  "version": "5.6.284",
  "identifier": "com.gdevelop-app.ide",
  "build": {
    "frontendDist": "../../app/build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GDevelop 5",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
